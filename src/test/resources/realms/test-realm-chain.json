{
  "id": "test-chain",
  "realm": "test-chain",
  "enabled": true,
  "sslRequired": "none",
  "verifiableCredentialsEnabled": true,
  "clients": [
    {
      "clientId": "test-app",
      "enabled": true,
      "secret": "password",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "attributes": {
        "oid4vci.enabled": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "id": "a971a9b9-e766-4438-b989-103991b31f45",
      "alias": "oid4vp auth",
      "description": "Authenticate via OpenID4VP presentations",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "oid4vp-authenticator",
          "authenticatorConfig": "oid4vp-auth-config",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 0,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "id": "test-chain-oid4vp-auth-config-id",
      "alias": "oid4vp-auth-config",
      "config": {
        "credentialTypes": "https://credentials.example.com/identity_credential"
      }
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "custom-rsa-chain",
        "providerId": "java-keystore",
        "config": {
          "algorithm": [
            "RS256"
          ],
          "active": [
            "true"
          ],
          "enabled": [
            "true"
          ],
          "priority": [
            "100"
          ],
          "keystore": [
            "keystore-chain-rsa.p12"
          ],
          "keystorePassword": [
            "password"
          ],
          "keystoreType": [
            "PKCS12"
          ],
          "keyAlias": [
            "test-metadata-leaf"
          ],
          "keyPassword": [
            "password"
          ]
        }
      }
    ]
  }
}
