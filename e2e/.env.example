# Isolated end-to-end environment for the credential-lifecycle journey.
# Copy to .env only to override; the defaults match the tests and the docs.

# Keycloak image (the container registry tag) and
# host port (consumed when the realm renders; see assets/realm/).
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0
KEYCLOAK_HTTP_PORT=18080

# Mock frontend (demo app), published by the mock-fe repo on release tags.
MOCK_FE_IMAGE=ghcr.io/adorsys-gis/keycloak-oid4vc-mock-fe:latest
MOCK_FE_HTTP_PORT=14200

# eudi-dev test wallet (headless, auto-accepting)
WALLET_IMAGE=ghcr.io/eudi-dev/eudi-dev:latest
WALLET_HTTP_PORT=18085

# Consumed by assets/realm/ when it renders build/realm.json.
STATUS_LIST_SERVER_URL=https://statuslist.eudi-adorsys.com
