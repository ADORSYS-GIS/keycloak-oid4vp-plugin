# Isolated end-to-end environment for the credential-lifecycle journey.
# Copy to .env only to override; the defaults match the tests and the docs.

# Keycloak image (the container registry tag) and
# host port (consumed when the realm renders; see assets/realm/).
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
KEYCLOAK_HTTP_PORT=18080

# Mock frontend (demo app), published by the mock-fe repo on release tags.
MOCK_FE_IMAGE=ghcr.io/adorsys-gis/keycloak-oid4vc-mock-fe:latest
MOCK_FE_HTTP_PORT=14200

# eudi-dev test wallet (headless, auto-accepting)
WALLET_IMAGE=ghcr.io/eudi-dev/eudi-dev:latest
WALLET_HTTP_PORT=18085

# Local status list server (run via docker-compose as part of the stack).
STATUS_LIST_SERVER_IMAGE=ghcr.io/adorsys/status-list-server:latest-fscert
# Host ports for the local status list server (plain HTTP, debugging only) and
# its TLS proxy (the endpoint Keycloak and the tests use).
STATUS_LIST_SERVER_PORT=18092
STATUS_LIST_HTTP_PORT=18091

# Consumed by assets/realm/ when it renders build/realm.json. Reachable from
# inside the compose network (Keycloak fetches it); the TLS proxy fronts the
# local server. Must be the bare base URL — the plugins append `/api/v1/...`.
# `status-list` is the proxy service name and a SAN of its certificate.
STATUS_LIST_SERVER_URL=https://status-list:8443
